# 秘密はコミットしない。値はローカル .env または Railway Variables のみに設定する。
# 本格利用は BE-2 以降。キー名は実装計画 §4.2 に沿って精査する。

# --- BE-1（M1 疎通・CORS）---
# development（既定）| production。production 時は CORS_ALLOW_ORIGINS が必須（空禁止）。
ENVIRONMENT=development
# ブラウザから API を直接叩く場合のみ必要（カンマ区切り）。空なら CORS ミドルウェアは無効。
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pyright（開発のみ。本番デプロイ先の環境変数には設定しない）
# 未設定なら scripts/run-pyright.sh は PATH 上の python / python3.13 を使う
PYRIGHT_PYTHON=/path/to/anaconda3/envs/py313/bin/python

# --- BE-2（M2 チャット・Bedrock / モック）---
# true のとき AWS を呼ばずエコー応答（development 向け。production では起動時バリデーションで禁止）
CHAT_MOCK_MODE=false
#
# リージョン・モデル ID（モック OFF のとき必須。本番かつ非モックでは BEDROCK_MODEL_ID 必須）
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
#
# --- このバックエンド（boto3 bedrock-runtime / Converse）の認証 ---
# アプリは OpenAI 互換 URL（OPENAI_BASE_URL 等）ではなく、AWS SDK の標準チェーンを使う。
#
# 【推奨・本番】実行環境に IAM ロールを付与し、環境変数に長期キーを置かない（実装計画 §4）。
#
# 【ローカル・開発】IAM ユーザー等の SigV4 認証（アクセスキー + シークレット + リージョン）
# リージョンは署名・接続先に使われる。boto3 とアプリの aws_region 設定の両方に効くよう AWS_REGION を推奨。
# 注意: アプリ起動時に backend/.env を os.environ に読み込む（boto3 が参照できるようにする）。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 一時クレデンシャル利用時のみ
# AWS_SESSION_TOKEN=
# boto3 タイムアウト（秒。省略時はアプリ既定）
BEDROCK_CONNECT_TIMEOUT_SECONDS=10
BEDROCK_READ_TIMEOUT_SECONDS=120

# --- BE-3（M3 論文 PDF）---
# 保管ディレクトリ（未設定・空なら backend/data/papers）
# PAPERS_STORAGE_DIR=
# アップロード最大バイト（既定 20MB、1024〜128MB）
# PAPER_MAX_UPLOAD_BYTES=20971520
# URL 取り込みを無効化（本番では false 推奨）
# PAPER_FETCH_ENABLED=true
# fetch のタイムアウト秒・最大ボディバイト
# PAPER_FETCH_TIMEOUT_SECONDS=30
# PAPER_FETCH_MAX_BYTES=20971520
# 空=スキーム・IP のみ検査。非空=カンマ区切りホストサフィックス（例: arxiv.org,example.org）
# PAPER_FETCH_HOST_ALLOWLIST=
# 古い PDF を削除するしきい値（秒、mtime）
# PAPER_GC_MAX_AGE_SECONDS=86400

# --- BE-5（M5 要約・PDF テキスト抽出上限）---
# 要約前に読む最大ページ数（1〜500、省略時 40）
# PAPER_EXTRACT_MAX_PAGES=40
# 抽出プレーンテキストの最大文字数（超過分は切り詰め、要約レスポンスの truncated_source で通知。1_000〜500_000、省略時 80000）
# PAPER_EXTRACT_MAX_CHARS=80000
