# フロントからブラウザに公開してよい値のみ NEXT_PUBLIC_ を付ける。
# 秘密（API キー・長期クレデンシャル）はここに書かず、Vercel の Environment Variables または
# サーバ専用キーとして設定する（実装計画 §4 参照）。

# FastAPI などバックエンドの基底 URL（クライアントから参照する場合）
# 例: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=

# --- サーバ専用（Route Handler / Server Action のみ。NEXT_PUBLIC_ にしないこと）---
# 運用コスト管理（FE-4）。API の Authorization: Bearer と /admin/cost の保存フォームで共用。
# COST_ADMIN_BEARER=
# 任意: JSON の保存先（未設定時は frontend/.data/cost-state.json）
# COST_DATA_FILE=

# --- 運用コスト 第 2 段階（自動取得・サーバ専用。NEXT_PUBLIC_ にしない）---
# Vercel Billing API（Team スコープ）
# COST_SYNC_VERCEL_TOKEN=
# COST_SYNC_VERCEL_TEAM_ID=
# Railway GraphQL（請求額は公開 API で取得しないため、トークンは疎通確認に使用）
# COST_SYNC_RAILWAY_TOKEN=
# Supabase Management API（組織コンテキスト）
# COST_SYNC_SUPABASE_ACCESS_TOKEN=
# COST_SYNC_SUPABASE_ORG_ID=
# AWS Cost Explorer（推奨: backend 用 AWS_* と分離するため COST_SYNC_AWS_* を優先。未設定時は AWS_ACCESS_KEY_ID 等にフォールバック）
# COST_SYNC_AWS_ACCESS_KEY_ID=
# COST_SYNC_AWS_SECRET_ACCESS_KEY=
